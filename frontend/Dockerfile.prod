FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# Minimal image — copies built dist into the shared volume on startup
FROM alpine:3.19
COPY --from=builder /app/dist /build
CMD ["sh", "-c", "rm -rf /app/dist/* && cp -r /build/. /app/dist/ && echo '[frontend] dist copied'"]
