# ── CoachOS Production Environment ────────────────────────────────────────────
# Copy to backend/.env and fill in all values before deployment

# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_use_python_secrets_token_urlsafe_50
DEBUG=False
# Must include "backend" (the Django service's own Docker Compose hostname) in
# addition to your real domain — the OnlyOffice document server fetches files by
# calling http://backend:8000/... directly (see ONLYOFFICE_CALLBACK_BASE_URL below),
# which sends `Host: backend:8000`. Without "backend" here, Django's ALLOWED_HOSTS
# check rejects that request with a 400 and OnlyOffice shows "Download failed."
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,backend
DOMAIN=yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://coachos:CHANGEME_DB_PASSWORD@db:5432/coachos
DB_PASSWORD=CHANGEME_DB_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_LIVE_SECRET_KEY=sk_live_...
STRIPE_TEST_SECRET_KEY=sk_test_...
DJSTRIPE_WEBHOOK_SECRET=whsec_...
# Set to True in production
STRIPE_LIVE_MODE=True

# ── AWS S3 (file storage) ─────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_STORAGE_BUCKET_NAME=coachos-files
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# ── Email ─────────────────────────────────────────────────────────────────────
# Option A: SendGrid
SENDGRID_API_KEY=SG...
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# Option B: SMTP
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# EMAIL_USE_TLS=True

# ── SMS (Twilio) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── Google OAuth & Calendar ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://yourdomain.com/accounts/google/login/callback/
# Shared secret Google echoes back in the X-Goog-Channel-Token header on every
# calendar push notification — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Requires the domain above to be verified in Google Search Console + added as an
# authorized domain on the OAuth consent screen before push notifications will work.
GOOGLE_CALENDAR_WEBHOOK_TOKEN=CHANGE_ME_use_python_secrets_token_urlsafe_32

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── OnlyOffice Document Server (real-time Word/Excel/PPT editing) ─────────────
# Served on the same domain/cert as the main site, on a separate port (see
# nginx/nginx.conf) — open this port in the EC2 security group before deploying.
ONLYOFFICE_SERVER_URL=https://yourdomain.com:8443
# "backend" = the Django service name in docker-compose.prod.yml (internal docker network)
ONLYOFFICE_CALLBACK_BASE_URL=http://backend:8000
ONLYOFFICE_JWT_SECRET=CHANGE_ME_use_python_secrets_token_urlsafe_50

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production
SITE_ID=1

# ── Internal cron endpoints ───────────────────────────────────────────────────
# Shared secret gating /api/internal/reminders/, /api/internal/invites/, and
# /api/internal/pipeline-alerts/ (X-Cron-Secret header). These endpoints are optional —
# Celery Beat already runs the same reminder/invite/pipeline-alert jobs automatically —
# only needed if you ALSO want an external pinger (e.g. cron-job.org) as a redundant
# trigger. Required if you use those endpoints at all; generate with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
CRON_SECRET=CHANGE_ME_use_python_secrets_token_urlsafe_32
